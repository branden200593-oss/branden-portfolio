{
  "name": "branden-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser.cjs",
    "test:hmr": "node tests/hmr.cjs",
    "test:studio": "node tests/studio.cjs",
    "test:routes": "node tests/routes.cjs",
    "lint": "eslint src vite.config.ts --max-warnings 0",
    "check": "npm run lint && npm run typecheck",
    "test:editorial": "node tests/editorial.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
